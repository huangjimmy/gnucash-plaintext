; A transaction with a comment line between its postings, at the end of a file with no newline after its last line.
;
; What this fixture produces: USD and CAD, Assets, Assets:Bank in CAD and
; Assets:Bank:USD in USD, and one transaction buying 100.00 USD for 135.00 CAD.
; Beancount allows a comment anywhere, so the line between the two postings is
; skipped rather than read as a posting, and the last posting's own metadata
; runs to the end of the file, where the reading stops.
;
; Verified by tests/integration/test_cli_beancount.py.
2026-01-10 commodity USD
    gnucash-mnemonic: "USD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "US Dollar"
    gnucash-fraction: "100"
2026-01-10 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2026-01-10 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "c0d7e000a2704b5a998d04e93c4b3fd2"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
    gnucash-tax-related: "False"
2026-01-10 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "bdfe3fdefd904b23b51a1804868ca092"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
    gnucash-tax-related: "False"
2026-01-10 open Assets:Bank:USD USD
    gnucash-name: "Assets:Bank:USD"
    gnucash-guid: "c8359c3d4dda449e9a62c73af570f977"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
    gnucash-tax-related: "False"
2026-01-10 * "Buy 100 USD at 1.35"
    gnucash-guid: "16b8eb8142634ab1b628dbff4ef8ad9a"
  Assets:Bank:USD 100.00 USD @@ 135.00 CAD
  ; paid out of the chequing account
  Assets:Bank -135.00 CAD
    receipt: "r-1"