; An export another tool has annotated.
;
; Metadata is the same `key: "value"` form everywhere in beancount, under a
; commodity, an `open`, a transaction header and a posting alike, and nothing
; orders it. Editors write their own keys into it — fava puts `name:` and
; `color:` on accounts — and this tool keeps only the `gnucash-*` ones.
;
; Reading the block until the first key it does not keep meant a foreign line
; hid every key below it, and what that cost depended only on where the person
; happened to type it:
;
;   - above `gnucash-mnemonic` or `gnucash-guid`, the whole file was refused
;     for metadata the file plainly carries;
;   - above `gnucash-notes` / `gnucash-doclink`, the note and the document
;     link were dropped without a word, and the next export wrote the
;     transaction without them;
;   - above `gnucash-scu`, the account was rebuilt at its commodity's
;     fraction, so 12.345 units no longer fit the account holding them — and
;     the refusal advised adding the `gnucash-scu:` the file already had;
;   - above `gnucash-fraction`, the commodity came back at the default 100.
;
; So every block is read to its end and the `gnucash-*` keys picked out of it,
; which is what the posting-level walk already did.
;
; The header also carries beancount's own tag and link, which have no GnuCash
; counterpart and must not stop the entry being read.
;
; What this fixture produces: one transaction, with the notes, the document
; link, the account's own unit and the commodity's fraction all intact.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 commodity FUND.FUNDX
    name: "Example Balanced Fund"
    gnucash-mnemonic: "FUNDX"
    gnucash-namespace: "FUND"
    gnucash-fullname: "Example Balanced Fund"
    export: "ignore"
    gnucash-fraction: "10000"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    color: "#aabbcc"
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
    gnucash-description: "Everyday chequing"
2024-01-01 open Assets:Fund FUND.FUNDX
    gnucash-name: "Assets:Fund"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Mutual Fund"
    gnucash-placeholder: "False"
    fava-name: "The fund"
    gnucash-scu: "1000"

2024-02-01 * "Payee" "Buy 12.345 units" #rrsp ^statement-2024-02
    category: "investing"
    gnucash-guid: "2222222222222222222222222222222a"
    gnucash-notes: "Quarterly contribution"
    gnucash-doclink: "receipts/2024-02-01-fund.pdf"
  Assets:Fund 12.345 FUND.FUNDX @@ 1234.50 CAD
    reviewed: "yes"
    gnucash-memo: "unit purchase"
  Assets:Bank -1234.50 CAD
