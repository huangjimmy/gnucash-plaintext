; A fund quantity finer than the account it sits on.
;
; A security is judged against its account's smallest unit, never a currency's
; — `12.345` is legal on an account kept to thousandths and `12.3456` is not.
; The plaintext importer refuses the second; this path did not ask, so
; `SetAmount` rounded it to 12.346 and the run reported `Errors: 0`. The value
; was computed from the figure the file stated, so the entry still balanced
; and nothing else flagged it: the quantity was simply not the one written,
; and the next export wrote the changed figure back.
;
; Which format the reader edited should not decide that.
;
; What this fixture produces: a refusal quoting the posting and naming the
; unit the account is kept to.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 commodity FUND.FUNDX
    gnucash-mnemonic: "FUNDX"
    gnucash-namespace: "FUND"
    gnucash-fullname: "Example Balanced Fund"
    gnucash-fraction: "100"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Fund FUND.FUNDX
    gnucash-name: "Assets:Fund"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Mutual Fund"
    gnucash-placeholder: "False"
    gnucash-scu: "1000"

2024-02-01 * "Payee" "Buy 12.3456 units"
    gnucash-guid: "2222222222222222222222222222222a"
  Assets:Fund 12.3456 FUND.FUNDX @@ 1234.56 CAD
  Assets:Bank -1234.56 CAD
