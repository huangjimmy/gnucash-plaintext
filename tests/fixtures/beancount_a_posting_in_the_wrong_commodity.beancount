; A posting whose commodity is not what its account holds.
;
; The commodity on a posting line was read once, to work out what the entry is
; denominated in, and never asked about again — the amount went to the account
; in whatever the account holds. So `Assets:Bank 50.00 USD` on a CAD account
; booked 50.00 CAD: the figure kept, its currency thrown away, the entry
; balancing against the other side, and the run reporting success.
;
; Which is the plainest hand-edit there is — change the account on a posting
; and leave the commodity behind.
;
; What this fixture produces: a refusal naming the posting, the commodity it
; states, and the one the account is kept in.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 commodity USD
    gnucash-mnemonic: "USD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "US Dollar"
    gnucash-fraction: "100"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Expenses CAD
    gnucash-name: "Expenses"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"

2024-02-01 * "Payee" "Lunch"
    gnucash-guid: "2222222222222222222222222222222a"
  Expenses 50.00 CAD
  Assets:Bank -50.00 USD
