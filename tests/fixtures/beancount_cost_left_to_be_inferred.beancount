; A posting whose cost is an empty basket: `{}`.
;
; In beancount that means "held at cost, and the cost is to be inferred" —
; worked out by a booking algorithm against the lots the account already holds.
; This reads a cost; it does not work one out, and GnuCash keeps no per-lot
; state to work one out from.
;
; Read as an unpriced posting it would be silently wrong exactly where it
; matters: 100.00 USD valued at 100.00 CAD against -135.00 CAD of cash, with
; GnuCash inventing an Imbalance for the 35.00. So it is refused, and the
; refusal names the four spellings that do state a cost.
;
; What this fixture produces: a refusal quoting the posting and listing
; `{rate CUR}`, `{{total CUR}}`, `@ rate CUR` and `@@ total CUR`.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 commodity USD
    gnucash-mnemonic: "USD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "US Dollar"
    gnucash-fraction: "100"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank:USD USD
    gnucash-name: "Assets:Bank:USD"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"

2024-02-01 * "Payee" "Bought USD, cost to be inferred"
    gnucash-guid: "2222222222222222222222222222222a"
  Assets:Bank:USD 100.00 USD {}
  Assets:Bank -135.00 CAD
