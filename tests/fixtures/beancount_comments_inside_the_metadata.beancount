; Comments written in among the metadata.
;
; beancount takes a comment anywhere, and a person annotating an export puts
; one where the note belongs — above the line it is about. The metadata walk
; stopped at it, so every `gnucash-*` key below the comment was dropped: the
; transaction's notes and document link, the account's description and its
; own unit, the commodity's fraction, the posting's memo. Silently, and only
; when the comment happened to land above them.
;
; Which is the failure the tolerant walk was written against, arriving through
; the one door left open.
;
; What this fixture produces: one transaction with everything the file states
; kept — notes, memo, description, SCU and fraction.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 commodity FUND.FUNDX
    gnucash-mnemonic: "FUNDX"
    gnucash-namespace: "FUND"
    ; the prospectus says four decimals
    gnucash-fullname: "Example Balanced Fund"
    gnucash-fraction: "10000"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
    ; renamed at the bank in 2023
    gnucash-description: "Everyday chequing"
2024-01-01 open Assets:Fund FUND.FUNDX
    gnucash-name: "Assets:Fund"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Mutual Fund"
    gnucash-placeholder: "False"
    ; units are held to thousandths here
    gnucash-scu: "1000"

2024-02-01 * "Payee" "Buy 12.345 units"
    gnucash-guid: "2222222222222222222222222222222a"
    ; from the statement, not the confirmation
    gnucash-notes: "Quarterly contribution"
    gnucash-doclink: "receipts/2024-02-01-fund.pdf"
  Assets:Fund 12.345 FUND.FUNDX @@ 1234.50 CAD
    ; the broker calls it a contribution
    gnucash-memo: "unit purchase"
  Assets:Bank -1234.50 CAD
