; An `open` directive with the account edited off it.
;
; Recognised by its whole shape, this matched nothing at all and was skipped
; in silence — and since the postings below still name the account, the file
; came back refused as `Implicit accounts not allowed: Assets:Bank`, against a
; file that plainly opens Assets:Bank four lines up.
;
; What this fixture produces: a refusal quoting the directive.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Expenses CAD
    gnucash-name: "Expenses"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"

2024-02-01 * "Grocer" "Lunch"
    gnucash-guid: "2222222222222222222222222222222a"
  Expenses 50.00 CAD
  Assets:Bank -50.00 CAD
