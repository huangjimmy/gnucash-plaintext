; A beancount file of this tool's own making, edited afterwards — which is
; the point of exporting to beancount at all. Every object that will not
; import is reported and the rest still lands, so one bad line does not cost
; the whole ledger.
;
; One edit, two failures, and they are reported in different places:
;   * Expenses:Broken declares a `gnucash-type` GnuCash has no such thing as,
;     so the account cannot be created;
;   * the second transaction posts to it, so it is not in the book to post to.
;
; What this fixture produces: 4 accounts, 1 transaction, and both failures
; named — the account's and the transaction's — rather than the run stopping
; at the first or the ledger being thrown away over it.
2024-01-15 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-15 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-15 open Expenses CAD
    gnucash-name: "Expenses"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"
2024-01-15 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-15 open Expenses:Fine CAD
    gnucash-name: "Expenses:Fine"
    gnucash-guid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"
2024-01-15 open Expenses:Broken CAD
    gnucash-name: "Expenses:Broken"
    gnucash-guid: "cccccccccccccccccccccccccccccccc"
    gnucash-type: "NOT-AN-ACCOUNT-TYPE"
    gnucash-placeholder: "False"

2024-01-16 * "Payee" "This one is fine"
    gnucash-guid: "dddddddddddddddddddddddddddddddd"
  Assets:Bank -10.00 CAD
  Expenses:Fine 10.00 CAD

2024-01-17 * "Payee" "Posts to the account that could not be made"
    gnucash-guid: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
  Assets:Bank -20.00 CAD
  Expenses:Broken 20.00 CAD
