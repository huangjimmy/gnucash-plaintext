; A posting that lost its indentation.
;
; Postings and their metadata are indented and top-level directives are not,
; which is how a transaction knows where it ends. A posting that slips back to
; column zero therefore reads as the next directive — and matches none of the
; three, so the outer loop skipped it in silence, the transaction imported
; without it, GnuCash scrubbed in an Imbalance for what was missing, and the
; run reported success.
;
; Losing the leading spaces on one line is the commonest hand-edit slip there
; is, so it is said rather than dropped.
;
; What this fixture produces: a refusal quoting the line and saying it is not
; indented, rather than a book missing a split.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Expenses CAD
    gnucash-name: "Expenses"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"
2024-01-01 open Expenses:Food CAD
    gnucash-name: "Expenses:Food"
    gnucash-guid: "1111111111111111111111111111111d"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"

2024-02-01 * "Payee" "Groceries"
    gnucash-guid: "2222222222222222222222222222222a"
  Assets:Bank -50.00 CAD
Expenses:Food 50.00 CAD
