; A date that is shaped like one and is not one.
;
; `2024-02-30` matches the date pattern every directive is recognised by, and
; fails in `strptime` two lines later. Left to fail there it came out as a
; bare `ValueError: day is out of range for month`, which is neither the
; refusal the import collects per object nor a message that says which line —
; no file, no directive, nothing to look for. The same is true of a
; `gnucash-fraction:` that is not a number.
;
; What this fixture produces: a refusal quoting the directive and the date.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-02-30 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Expenses CAD
    gnucash-name: "Expenses"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"

2024-02-01 * "Grocer" "Lunch"
    gnucash-guid: "2222222222222222222222222222222a"
  Expenses 50.00 CAD
  Assets:Bank -50.00 CAD
