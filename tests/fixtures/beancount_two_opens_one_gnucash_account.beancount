; Two `open` directives naming one GnuCash account.
;
; A beancount account name cannot hold every character a GnuCash one can, so
; the two views are kept apart: the beancount name is what postings are
; written against, and `gnucash-name` is the account they mean. Renaming in
; the beancount view is therefore a hand-edit that can point two of them at
; one account — here `Assets:Bank` and `Assets:BankCAD`.
;
; The second `open` finds the account already there and creates nothing, but
; the counter added one per directive that did not raise, so the run reported
; four accounts over a book holding three.
;
; What this fixture produces: three accounts, and a summary that says three.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Assets:BankCAD CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Expenses CAD
    gnucash-name: "Expenses"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"

2024-02-01 * "Payee" "Lunch"
    gnucash-guid: "2222222222222222222222222222222a"
  Expenses 50.00 CAD
  Assets:BankCAD -50.00 CAD
