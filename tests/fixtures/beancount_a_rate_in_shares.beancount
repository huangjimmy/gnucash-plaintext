2024-02-01 * "Broker" "OLDCO taken over by NEWCO"
    gnucash-guid: "2222222222222222222222222222222a"
  Assets:Broker:OLDCO -100 NASDAQ.OLDCO @ 0.5 NASDAQ.NEWCO
  Assets:Broker:NEWCO 50 NASDAQ.NEWCO
  Assets:Bank 12.50 CAD
