    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Broker CAD
    gnucash-name: "Assets:Broker"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Asset"
    gnucash-placeholder: "True"
2024-01-01 open Assets:Broker:OLDCO NASDAQ.OLDCO
    gnucash-name: "Assets:Broker:OLDCO"
    gnucash-guid: "1111111111111111111111111111111d"
    gnucash-type: "Stock"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Broker:NEWCO NASDAQ.NEWCO
    gnucash-name: "Assets:Broker:NEWCO"
    gnucash-guid: "1111111111111111111111111111111e"
    gnucash-type: "Stock"
