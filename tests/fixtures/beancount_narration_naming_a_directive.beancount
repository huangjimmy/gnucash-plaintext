; An ordinary exported ledger whose descriptions happen to contain the words
; the parser dispatches on. "Bought a commodity for resale" and "Left the open
; box" are things a person writes on a transaction; neither is a directive.
2024-01-15 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-15 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-15 open Expenses CAD
    gnucash-name: "Expenses"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"
2024-01-15 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-15 open Expenses:Stock CAD
    gnucash-name: "Expenses:Stock"
    gnucash-guid: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"

2024-01-16 * "Acme" "Bought a commodity for resale"
    gnucash-guid: "dddddddddddddddddddddddddddddddd"
  Assets:Bank -10.00 CAD
  Expenses:Stock 10.00 CAD

2024-01-17 * "Acme" "Left the open box at reception"
    gnucash-guid: "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
  Assets:Bank -20.00 CAD
  Expenses:Stock 20.00 CAD
