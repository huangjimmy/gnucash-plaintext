; Metadata values written the way beancount types them.
;
; A beancount metadata value is not always a string: a number is written bare,
; and that is the natural way to write one. This tool quotes everything it
; emits, so its own files always round-trip — and a person widening an
; account's unit by hand writes `gnucash-scu: 1000`.
;
; Read as a quoted string or not at all, such a line was recognised as
; metadata, consumed, and dropped without a word: the account was rebuilt at
; its commodity's fraction, GnuCash rounded every amount to it on save, and
; 12.345 units came back as 12.35 under a run reporting no errors.
; `gnucash-fraction: 10000` fell back to 100 the same way.
;
; What this fixture produces: one transaction, with the account kept to
; thousandths and the commodity at its stated fraction.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: 100
2024-01-01 commodity FUND.FUNDX
    gnucash-mnemonic: "FUNDX"
    gnucash-namespace: "FUND"
    gnucash-fullname: "Example Balanced Fund"
    gnucash-fraction: 10000
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Fund FUND.FUNDX
    gnucash-name: "Assets:Fund"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Mutual Fund"
    gnucash-placeholder: "False"
    gnucash-scu: 1000

2024-02-01 * "Broker" "Buy 12.345 units"
    gnucash-guid: "2222222222222222222222222222222a"
  Assets:Fund 12.345 FUND.FUNDX @@ 1234.50 CAD
  Assets:Bank -1234.50 CAD
