; A line inside a transaction that is not a posting and not metadata.
;
; Treated as the end of the transaction, everything below it went with it: the
; entry imported carrying only the postings above the bad line, GnuCash
; balanced what was left by inventing an Imbalance split, and the run reported
; success. A file with a typo on one line quietly became a book with a
; transaction that says something else.
;
; What this fixture produces: a refusal naming the line it cannot read and
; saying what a posting looks like, rather than a book.
;
; Verified by tests/integration/test_beancount_reads_what_a_person_writes.py.
2024-01-01 commodity CAD
    gnucash-mnemonic: "CAD"
    gnucash-namespace: "CURRENCY"
    gnucash-fullname: "Canadian Dollar"
    gnucash-fraction: "100"
2024-01-01 open Assets CAD
    gnucash-name: "Assets"
    gnucash-guid: "1111111111111111111111111111111a"
    gnucash-type: "Asset"
    gnucash-placeholder: "False"
2024-01-01 open Assets:Bank CAD
    gnucash-name: "Assets:Bank"
    gnucash-guid: "1111111111111111111111111111111b"
    gnucash-type: "Bank"
    gnucash-placeholder: "False"
2024-01-01 open Expenses CAD
    gnucash-name: "Expenses"
    gnucash-guid: "1111111111111111111111111111111c"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"
2024-01-01 open Expenses:Food CAD
    gnucash-name: "Expenses:Food"
    gnucash-guid: "1111111111111111111111111111111d"
    gnucash-type: "Expense"
    gnucash-placeholder: "False"

2024-02-01 * "Payee" "Groceries"
    gnucash-guid: "2222222222222222222222222222222a"
  Assets:Bank -50.00 CAD
  Expenses:Food 50.00 CADD EXTRA
  Expenses:Food 0.00 CAD
