#!/bin/bash
#
# commit-msg hook: refuse an attribution line and a hard-wrapped message, then run the independent AI review with the message.
#
# CLAUDE.md says no attribution lines, and an agent working here is told otherwise by the tool running it, which appends a `Co-Authored-By:` trailer and a session URL to commits. That instruction arrives with each run and is written nowhere a reader of this repo can see, so the rule is enforced here rather than trusted. The switch on the tool's side is the `attribution` object in Claude Code settings, which stops the line being offered at all; this is the floor under it.
#
# What it refuses is Claude's own marks and nothing else: a `Co-Authored-By:` line giving an anthropic.com address, a `Claude-Session:` trailer, either Claude URL, and the "Generated with Claude Code" footer. A person's trailer carries none of these and passes, which matters because three commits on `main` already have one, written by GitHub's squash-merge dialog. The trailer rules are anchored at the start of a line, so prose that mentions one passes; the URLs and the footer are matched anywhere.
#
# A diff is skipped from its own `diff --git` header down, because `git commit -v` puts one below the message and this repo's diff carries the lines this check refuses.
#
# A paragraph in this project's commit messages is one line, and this file is written the way it asks messages to be written.
#
# Breaking a paragraph at a column bakes the author's terminal width into the history: every reader's terminal, `git log`, and every web view re-flow it to their own width, and a paragraph already broken at someone else's reads as ragged half-lines in all of them. It also makes an edit to one sentence rewrite every line after it, so the diff of a reworded paragraph is the whole paragraph.
#
# So: a long line followed by another line of the same paragraph is a break, and the commit is refused. Blank lines separate paragraphs, and lists, tables, quotes, indented blocks and fenced code are left alone — their line breaks are the content, not a column.
#
# "Long" is the one number here, and it is a floor rather than a width: a line under it is short enough to be a deliberate line of its own — a label, a short sentence — and is never reported, whatever follows it.
#
# The subject is exempt: it is one line by definition and is meant to be short.
#
# A carriage return is taken off every line first. An editor set to save CRLF leaves them in the file the hook is handed, and a blank line arriving as "\r" would read as text rather than as the end of a paragraph.

MESSAGE_FILE="$1"

ATTRIBUTION=$(awk '
  { sub(/\r$/, "") }
  /^diff --git / { exit }
  {
    text = $0
    # Plain classes rather than [[:space:]], which mawk 1.3.3 on Debian 10 reads as the literal characters.
    sub(/^[ \t]+/, "", text)
    sub(/^#+[ \t]*/, "", text)
    sub(/^[ \t]+/, "", text)
    folded = tolower(text)

    if (folded ~ /^co-authored-by:/ && index(folded, "anthropic.com") > 0) { printf "  line %d: %s\n", NR, $0; next }
    if (folded ~ /^claude-session:/)                                      { printf "  line %d: %s\n", NR, $0; next }
    if (index(folded, "claude.ai/code") > 0)                              { printf "  line %d: %s\n", NR, $0; next }
    if (index(folded, "claude.com/claude-code") > 0)                      { printf "  line %d: %s\n", NR, $0; next }
    if (index(folded, "generated with [claude code]") > 0)                { printf "  line %d: %s\n", NR, $0; next }
    if (index(folded, "generated with claude code") > 0)                  { printf "  line %d: %s\n", NR, $0; next }
  }
' "$MESSAGE_FILE")

if [ -n "$ATTRIBUTION" ]; then
    echo "❌ Commit blocked: the message carries an attribution line."
    echo ""
    echo "This history records the people who did the work, and nothing else:"
    echo ""
    echo "$ATTRIBUTION"
    echo ""
    echo "Remove the line. If a tool put it there, the switch is the \`attribution\` object in Claude Code settings — \`{\"commit\": \"\", \"pr\": \"\", \"sessionUrl\": false}\` — which stops it being offered at all, on a pull request body as well as here."
    exit 1
fi

WRAPPED=$(awk '
  { sub(/\r$/, "") }
  # Everything from the scissors line down is git`s own, not the message.
  /^# ------------------------ >8 ------------------------$/ { exit }
  /^#/ { next }
  { line[++n] = $0 }
  END {
    fenced = 0
    for (i = 2; i <= n; i++) {
      current = line[i]
      following = line[i + 1]

      if (current ~ /^```/) { fenced = !fenced; continue }
      if (fenced) continue

      # A paragraph ends at a blank line, and the last line has no successor.
      if (current == "" || i == n || following == "") continue

      # Short lines are not a wrap: a two-line signature, a pair of labels, a sentence that simply ends early.
      if (length(current) < 64) continue

      # The next line starts something of its own rather than continuing this paragraph: a bullet, a numbered item, a table row, a quote, a heading, an indented or fenced block.
      # Plain classes rather than [[:space:]], which mawk 1.3.3 on Debian 10 reads as the literal characters: these three exemptions did nothing there, so an indented continuation, a bullet and a numbered item were each reported as a wrap on that build alone.
      if (following ~ /^[ \t]/)              continue
      if (following ~ /^[-*+][ \t]/)         continue
      if (following ~ /^[0-9]+[.)][ \t]/)    continue
      if (following ~ /^[|>#]/)              continue
      if (following ~ /^```/)                continue

      printf "  line %d: %s\n", i, current
    }
  }
' "$MESSAGE_FILE")

if [ -n "$WRAPPED" ]; then
    echo "❌ Commit blocked: the message is hard-wrapped."
    echo ""
    echo "These lines are long and the line after each continues the same paragraph, so the paragraph has been broken at a column:"
    echo ""
    echo "$WRAPPED"
    echo ""
    echo "Write one paragraph as one line and separate paragraphs with a blank line. Lists, tables, quotes and fenced code are left alone."
    exit 1
fi

# The independent AI review of the staged diff runs here, with the message, and not in the pre-commit hook: git runs that hook before it reads the message, so a review started there was handed none and read "[No commit message provided]" in its place. For a `git commit`, git runs this hook only once the pre-commit hook has passed, so a commit the lint, the suite or the coverage gate refuses still costs no review.
#
# Two runs of this hook are not reviewed. A merge that makes a commit runs this hook and not the pre-commit one, and its staged diff is everything being merged in — hours of review with no lint, suite or coverage gate before it. And a commit with nothing staged — an amend that only rewords, a reword in a rebase — has no change to review.
#
# What is handed over is the message as it will be stored: git's comment lines and everything below the scissors line `git commit -v` adds are left out.
if [ "$SKIP_AI_REVIEW" = "1" ]; then
    echo "⚠️  AI review skipped (SKIP_AI_REVIEW=1)"
    exit 0
fi
if [ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
    echo "⚠️  A merge commit: the pre-commit checks did not run, so neither does the AI review"
    exit 0
fi
if git diff --staged --quiet; then
    echo "⚠️  No staged changes - nothing to review"
    exit 0
fi

echo "3. Running independent AI review..."
MESSAGE=$(awk '/^# ------------------------ >8 ------------------------$/ { exit } { print }' "$MESSAGE_FILE" | git stripspace --strip-comments)
PROJECT_ROOT=$(git rev-parse --show-toplevel)
if ! "$PROJECT_ROOT/scripts/review-commit.sh" -m "$MESSAGE"; then
    echo "❌ Commit blocked: AI review found concerns. Address them, or skip the review alone with SKIP_AI_REVIEW=1 — --no-verify skips every check, the attribution and wrapping ones as well."
    exit 1
fi

exit 0
