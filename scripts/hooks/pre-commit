#!/bin/bash
#
# Pre-commit hook: Run linter, tests, and independent AI review
#
# Flow:
#   1. Run lint on staged Python files (skipped when none are staged)
#   2. Run tests via test-all-versions-parallel.sh with coverage on — skipped for
#      documentation-only commits (only *.md / docs/ staged), since docs cannot
#      affect the test suite
#   2b. Gate the eleven runs added together at 100% line and branch coverage
#   3. If lint, tests OR coverage failed → block immediately (no AI review = no
#      wasted tokens)
#   4. AI review runs always (including docs-only commits) → block on concerns
#

echo "Running pre-commit checks..."
echo ""

LINT_FAILED=0
TEST_FAILED=0
COVERAGE_FAILED=0
LINT_OUTPUT=""
TEST_OUTPUT=""
COVERAGE_OUTPUT=""

# Check if Docker is available
if ! command -v docker > /dev/null 2>&1; then
    echo "⚠️  Docker not found - skipping linting and tests"
    echo "   Install Docker to enable pre-commit checks"
    echo ""
else
    # 1. Lint staged Python files
    echo "1. Running linting..."

    STAGED_PY_FILES=$(git diff --staged --name-only --diff-filter=ACM | grep '\.py$' | tr '\n' ' ' || true)

    if [ -z "$STAGED_PY_FILES" ]; then
        echo "⚠️  No Python files staged - skipping linting"
        echo ""
    else
        if ! LINT_OUTPUT=$(./scripts/lint.sh $STAGED_PY_FILES 2>&1); then
            LINT_FAILED=1
            echo "❌ Linting failed"
            echo ""
        else
            echo "✓ Linting passed"
            echo ""
        fi
    fi

    # 2. Run tests against all supported versions — skipped for documentation-only
    #    commits. Markdown (*.md) and anything under docs/ cannot change Python
    #    behaviour, so the slow cross-version suite adds no signal; the AI review
    #    (step 4) still runs. Any non-doc staged file (code, scripts, templates,
    #    Dockerfiles, configs) keeps the full suite.
    STAGED_NONDOC=$(git diff --staged --name-only --diff-filter=ACM | grep -vE '(\.md$|^docs/)' | tr '\n' ' ' || true)
    if [ -z "$STAGED_NONDOC" ]; then
        echo "2. Running tests..."
        echo "⚠️  Documentation-only change - skipping tests (AI review still runs)"
        echo ""
    else
        echo "2. Running tests (all versions, with coverage)..."
        # With coverage on, so the same eleven runs answer the second question
        # below without being run twice. Each container writes
        # `.coverage-data/.coverage.<tag>` under a name of its own.
        #
        # The directory is emptied first because what is in it outlives a run:
        # data from a tree that has since changed reports a figure for code that
        # no longer exists, and a `.partial-sweep` file left by a failed
        # ./scripts/coverage.sh would make the gate below refuse to give a
        # verdict at all.
        rm -rf .coverage-data
        if ! TEST_OUTPUT=$(GNC_COVERAGE=1 GNC_COVERAGE_DIR="$(pwd)/.coverage-data" \
                           ./scripts/test-all-versions-parallel.sh 2>&1); then
            TEST_FAILED=1
            echo "❌ Tests failed"
            echo ""
        else
            echo "✓ Tests passed"
            echo ""

            # Every line and branch the eleven runs reached, added up. A commit
            # that adds a line no supported version executes is blocked here,
            # the way a lint failure is: either a test reaches it, or it cannot
            # be reached and the line is the defect.
            echo "2b. Combining coverage (all versions)..."
            if ! COVERAGE_OUTPUT=$(./scripts/coverage.sh --report-only --threshold 100 2>&1); then
                COVERAGE_FAILED=1
                echo "❌ Coverage is short of 100% on the union"
                echo ""
            else
                echo "✓ Coverage is at 100% on the union"
                echo ""
            fi
        fi
    fi

    # 3. Block immediately if lint, tests or coverage failed — skip AI review to
    #    save tokens
    if [ $LINT_FAILED -eq 1 ] || [ $TEST_FAILED -eq 1 ] || [ $COVERAGE_FAILED -eq 1 ]; then
        if [ $LINT_FAILED -eq 1 ]; then
            echo "Linting errors:"
            echo "$LINT_OUTPUT"
            echo ""
            echo "Fix with: ./scripts/fix-lint.sh --unsafe"
            echo ""
        fi
        if [ $TEST_FAILED -eq 1 ]; then
            echo "Test failures (last 50 lines):"
            echo "$TEST_OUTPUT" | tail -50
            echo ""
        fi
        if [ $COVERAGE_FAILED -eq 1 ]; then
            # Whole, not tailed: what this prints is the list of missed lines
            # and branches, file by file, and the verdict is the last of it.
            echo "$COVERAGE_OUTPUT"
            echo ""
        fi
        echo "❌ Commit blocked: fix lint/test/coverage failures before committing."
        exit 1
    fi
fi

# 4. AI review — only reached when lint + tests both pass
echo "3. Running independent AI review..."

STAGED_DIFF=$(git diff --staged --no-color)

if [ -z "$STAGED_DIFF" ]; then
    echo "⚠️  No staged changes - nothing to review"
    echo ""
    echo "✓ All pre-commit checks passed!"
    exit 0
fi

# Allow skipping AI review for quick commits
if [ "$SKIP_AI_REVIEW" = "1" ]; then
    echo "⚠️  AI review skipped (SKIP_AI_REVIEW=1)"
    echo "✓ All pre-commit checks passed!"
    exit 0
fi

# Find the project root reliably based on the hook's execution path
if git rev-parse --is-inside-work-tree > /dev/null 2>&1; then
    PROJECT_ROOT=$(git rev-parse --show-toplevel)
else
    # Fallback if not run by git
    PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
fi

# Call the unified AI review script
if ! "$PROJECT_ROOT/scripts/review-commit.sh"; then
    echo "❌ Commit blocked: AI review found concerns. Address them or use 'git commit --no-verify' to skip checks."
    exit 1
fi

echo "✓ All pre-commit checks passed!"
exit 0
